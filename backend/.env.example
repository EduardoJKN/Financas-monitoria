# Conexão de execução (role restrita app_runtime, sem BYPASSRLS) — a
# mesma usada pelo Streamlit em finance_app/.env (APP_DATABASE_URL).
APP_DATABASE_URL=postgresql://app_runtime.PROJECT_REF:senha@host:5432/banco

# Usado para buscar o JWKS público do projeto (validação local de JWT —
# ver app/core/security.py). Não é um segredo: é a URL pública do projeto.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Origem permitida por CORS (Parte 39) — nunca "*". Em produção, defina
# com o domínio real do frontend.
FRONTEND_URL=http://localhost:3000

AMBIENTE=development

# Reservadas para uso futuro (ex.: endpoints administrativos). O backend
# hoje NÃO usa nenhuma das duas — reduz a superfície de credenciais
# sensíveis que este processo precisa ter em memória. Deixe em branco
# a menos que uma funcionalidade futura realmente precise delas.
# DATABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
