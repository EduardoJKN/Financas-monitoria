# Conexão administrativa: usada pelo Alembic (migrations) e por operações
# administrativas estreitas e auditadas (reivindicação de dados legados).
# Esta role tem privilégio de DDL e contorna RLS — nunca é usada para servir
# dados de um usuário autenticado.
DATABASE_URL=postgresql://postgres.PROJECT_REF:senha@host:5432/banco

# Conexão de execução da aplicação: role restrita (app_runtime, criada pela
# migration 0005), sem BYPASSRLS, sujeita de fato às políticas de RLS. É
# esta conexão que atende usuários autenticados. Veja README.md (seção
# "Arquitetura multiusuário") para como criar a senha desta role.
APP_DATABASE_URL=postgresql://app_runtime.PROJECT_REF:senha@host:5432/banco

# Supabase Auth (login/cadastro/recuperação de senha). Encontre em
# Project Settings > API no painel do Supabase.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública desta aplicação, usada como email_redirect_to ao cadastrar e
# ao reenviar confirmação de e-mail (em vez de depender só do Site URL
# configurado no painel do Supabase). Opcional: sem ela, o Site URL do
# projeto é usado como fallback. Em desenvolvimento local:
# APP_URL=http://localhost:8501
APP_URL=http://localhost:8501
